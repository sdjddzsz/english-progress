# ============================================================
# WorkBuddy 云服务配置（复制为 .env 并填入真实值）
# ------------------------------------------------------------
# 这三项来自 WorkBuddy 云服务开通后返回的 publicConfig：
#   { resourceId, endpoint, oauthRelayBaseUrl, publishableKey }
# 其中 resourceId 不需要配置。前端只持有 publishableKey
# （它本身无权限，服务端按 Origin 精确匹配），不含任何长期密钥。
# ============================================================

# 云数据面基础 URL（必填）。来源：publicConfig.endpoint
VITE_CLOUD_ENDPOINT=

# 应用标识 key（必填）。来源：publicConfig.publishableKey
VITE_CLOUD_PUBLISHABLE_KEY=

# OAuth Relay 基础 URL（web 端微信扫码登录需要；不用微信登录可留空）。
# 来源：publicConfig.oauthRelayBaseUrl
VITE_CLOUD_OAUTH_RELAY_BASE_URL=
